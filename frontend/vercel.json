{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://lingo-vocab-backend.onrender.com/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "microphone=*" }
      ]
    }
  ]
}
